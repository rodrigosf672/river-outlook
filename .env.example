# Gateway (Runpod CPU Pod). Set these as Pod env vars; reference Runpod secrets
# for the keys, e.g. RUNPOD_API_KEY={{ RUNPOD_SECRET_runpod_api_key }}

# Runpod Serverless endpoint running worker/ (omit both to serve the CPU baseline only)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Optional: free api.data.gov key, raises the USGS limit above ~1,000 req/hour/IP
USGS_API_KEY=

# Optional tuning (defaults shown)
GPU_DEADLINE_S=120
HISTORY_DAYS=90
CACHE_TTL_S=900
STALE_TTL_S=21600
RATE_LIMIT_PER_MIN=30
ALLOWED_ORIGINS=*
# Enables ?simulate=... failure drills. Turn on for the live demo only.
ALLOW_FAULT_INJECTION=false
